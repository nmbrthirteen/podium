# local or hosted. Hosted adds accounts and turns off the CLI coach.
PODIUM_MODE=local
PODIUM_DATA_DIR=

# Optional. Leave empty to keep the database in PODIUM_DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required in hosted mode.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in hosted mode, optional locally.
OPENROUTER_API_KEY=
PODIUM_AI_MODEL=anthropic/claude-sonnet-5

# off skips every coach call.
PODIUM_COACH=on
